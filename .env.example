PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/saveur
JWT_SECRET=change-this-secret-before-submission
CLIENT_URL=http://localhost:3000
AUTO_SEED=true

# Frontend API URL. Leave empty in production when Express serves the built app.
VITE_API_URL=http://localhost:5000/api

# Legacy nutritional database (Spring Boot SOAP service, see legacy-nutritional-db/)
NUTRITION_WSDL_URL=http://localhost:8080/ws/mon-service.wsdl
# Timeout (ms) for loading the WSDL and for each SOAP call
NUTRITION_TIMEOUT_MS=5000
