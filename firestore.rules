rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitive Definitions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'miguelandy875@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Helpers ---

    function isValidRecipe(data) {
      return data.keys().hasAll(['title', 'prepTime', 'difficulty', 'servings', 'categoryId', 'userId'])
        && data.title is string && data.title.size() <= 100
        && data.prepTime is int && data.prepTime >= 0
        && data.difficulty is int && data.difficulty >= 1 && data.difficulty <= 5
        && data.servings is int && data.servings > 0
        && data.categoryId is string
        && (data.userId == request.auth.uid || isAdmin());
    }

    function isValidMealPlan(data) {
      return data.keys().hasAll(['userId', 'date', 'recipeId', 'mealType'])
        && data.userId == request.auth.uid
        && data.date is string && data.recipeId is string
        && data.mealType is string;
    }

    // --- Collection Rules ---

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ingredients/{ingredientId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /recipes/{recipeId} {
      allow read: if existing().isPublic == true || isOwner(existing().userId) || isAdmin();
      allow create: if (isEmailVerified() || isAdmin()) && isValidRecipe(incoming());
      allow update: if (isOwner(existing().userId) || isAdmin())
        && isValidRecipe(incoming())
        && (incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'prepTime', 'cookTime', 'difficulty', 'servings', 'categoryId', 'imageUrl', 'isPublic']))
        && (incoming().userId == existing().userId || isAdmin());
      allow delete: if isOwner(existing().userId) || isAdmin();

      match /steps/{stepId} {
        allow read: if get(/databases/$(database)/documents/recipes/$(recipeId)).data.isPublic == true 
          || isOwner(get(/databases/$(database)/documents/recipes/$(recipeId)).data.userId)
          || isAdmin();
        allow write: if isOwner(get(/databases/$(database)/documents/recipes/$(recipeId)).data.userId) || isAdmin();
      }

      match /ingredients/{riId} {
        allow read: if get(/databases/$(database)/documents/recipes/$(recipeId)).data.isPublic == true 
          || isOwner(get(/databases/$(database)/documents/recipes/$(recipeId)).data.userId)
          || isAdmin();
        allow write: if isOwner(get(/databases/$(database)/documents/recipes/$(recipeId)).data.userId) || isAdmin();
      }
    }

    match /mealPlans/{planId} {
      allow list, get: if isOwner(existing().userId) || isAdmin();
      allow create: if (isEmailVerified() || isAdmin()) && isValidMealPlan(incoming());
      allow update: if (isOwner(existing().userId) || isAdmin()) && isValidMealPlan(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['date', 'recipeId', 'mealType']);
      allow delete: if isOwner(existing().userId) || isAdmin();
    }

    match /userFavorites/{favId} {
      allow list, get: if isOwner(existing().userId) || isAdmin();
      allow create: if (isEmailVerified() || isAdmin()) && (incoming().userId == request.auth.uid || isAdmin());
      allow delete: if isOwner(existing().userId) || isAdmin();
    }
  }
}
